{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:pytorch.org)",
      "WebFetch(domain:docs.python.org)",
      "Bash(wc:*)",
      "Bash(uv:*)",
      "Bash(python:*)",
      "Bash(nvidia-smi)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-experiment-log.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-progress-updated.sh"
          }
        ]
      }
    ]
  }
}
